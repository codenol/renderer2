{
  "meta": {
    "title": "Геораспределённые кластеры ПАК",
    "version": "1.0",
    "description": "Список геораспределённых кластеров с регионами, статусами и версиями",
    "figmaUrl": "https://www.figma.com/design/hf0n4mADFCmnjGBFCi0c0y"
  },

  "pages": [
    {
      "id": "pak-geo-clusters",
      "path": "/geo-clusters",
      "title": "Геораспределённые кластеры",
      "layout": {
        "type": "app-shell",
        "id": "root",
        "props": {
          "sidebar": {
            "type": "sidebar",
            "id": "main-sidebar",
            "props": {
              "items": [
                { "id": "nav-health",   "label": "Здоровье ПАК",        "icon": "activity",       "href": "/",              "state": "default" },
                { "id": "nav-geo",      "label": "Геораспр. кластеры",  "icon": "network",        "href": "/geo-clusters",  "state": "active" },
                { "id": "nav-overview", "label": "Обзор",               "icon": "layout-dashboard","href": "/overview",     "state": "default" },
                { "id": "nav-objects",  "label": "Объекты",             "icon": "server",         "href": "/objects",       "state": "default" },
                { "id": "nav-journal",  "label": "Журнал событий",      "icon": "list",           "href": "/journal",       "state": "default" }
              ]
            }
          },
          "breadcrumbs": {
            "type": "breadcrumbs",
            "id": "bc-main",
            "props": {
              "items": [
                { "label": "ПАК", "href": "/pak" },
                { "label": "Геораспределённые кластеры" }
              ]
            }
          },
          "content": {
            "type": "vstack",
            "id": "content-root",
            "props": { "gap": 24, "padding": "32 40" },
            "children": [

              {
                "type": "hstack",
                "id": "page-header",
                "props": { "justify": "space-between", "align": "center" },
                "children": [
                  {
                    "type": "text",
                    "id": "page-title",
                    "props": { "text": "Геораспределённые кластеры", "variant": "h2" }
                  },
                  {
                    "type": "button",
                    "id": "btn-add-cluster",
                    "props": { "label": "Добавить кластер", "variant": "accent", "size": "lg", "onClick": "none" }
                  }
                ]
              },

              {
                "type": "table",
                "id": "tbl-clusters",
                "props": {
                  "columns": [
                    { "key": "name",    "label": "Кластер",  "width": "auto",  "type": "text" },
                    { "key": "region",  "label": "Регион",   "width": "auto",  "type": "text" },
                    { "key": "status",  "label": "Статус",   "width": "160px", "type": "status-badge" },
                    { "key": "nodes",   "label": "Ноды",     "width": "100px", "type": "badge" },
                    { "key": "version", "label": "Версия",   "width": "120px", "type": "badge" },
                    { "key": "created", "label": "Дата создания", "width": "140px", "type": "text" },
                    { "key": "action",  "label": "Действия", "width": "140px", "type": "button" }
                  ],
                  "data": [
                    {
                      "name": "Москва-ЦОД-1",
